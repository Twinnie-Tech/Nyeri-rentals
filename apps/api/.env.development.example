# Local development — copy to apps/api/.env
# Postgres/Redis: pnpm docker:up (from repo root)

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://greenkey:greenkey@localhost:5433/greenkey?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Local: console providers (OTP printed in API logs + optional devCode)
SMS_PROVIDER=console
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console

# Or point at sandbox AT / Infobip / Mailtrap while developing:
# SMS_PROVIDER=africastalking
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SANDBOX=true
# WHATSAPP_PROVIDER=infobip
# INFOBIP_BASE_URL=https://YOUR_SUBDOMAIN.api.infobip.com
# INFOBIP_API_KEY=
# INFOBIP_WHATSAPP_FROM=447860099299
# EMAIL_PROVIDER=mailtrap
# MAILTRAP_USER=
# MAILTRAP_PASS=

MAIL_FROM_NAME=GreenKey Realty
MAIL_FROM_EMAIL=noreply@greenkey.test

AGENT_PLAN_AMOUNT_KES=2500
AGENT_PLAN_DAYS=30

MPESA_ENV=sandbox
MPESA_CALLBACK_URL=http://localhost:4000/v1/billing/mpesa/callback
MPESA_ACCOUNT_REFERENCE=GreenKeyAgent

BANK_NAME=Equity Bank
BANK_ACCOUNT_NAME=GreenKey Realty

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_WRITE_TOKEN=
