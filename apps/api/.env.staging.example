# Copy to apps/api/.env.staging (or inject these into your staging host).
# QA / staging uses Mailtrap Email Testing — messages never reach real inboxes.

NODE_ENV=staging
PORT=4000
APP_URL=https://staging.yourdomain.com
API_URL=https://api-staging.yourdomain.com
CORS_ORIGINS=https://staging.yourdomain.com

DATABASE_URL=
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Phone OTP: SMS + WhatsApp in parallel (see docs/MESSAGING.md)
# Phone OTP: SMS (AT) + WhatsApp (Infobip) — see docs/MESSAGING.md
SMS_PROVIDER=africastalking
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=infobip
AT_USERNAME=sandbox
AT_API_KEY=
AT_SMS_FROM=
AT_SANDBOX=true
AT_WHATSAPP_NUMBER=
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_FROM=447860099299

EMAIL_PROVIDER=mailtrap
MAIL_FROM_NAME=GreenKey Realty
MAIL_FROM_EMAIL=noreply@greenkey.test
MAILTRAP_USER=
MAILTRAP_PASS=
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525

AGENT_PLAN_AMOUNT_KES=2500
AGENT_PLAN_DAYS=30

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api-staging.yourdomain.com/v1/billing/mpesa/callback
MPESA_ACCOUNT_REFERENCE=GreenKeyAgent

BANK_NAME=Equity Bank
BANK_ACCOUNT_NAME=GreenKey Realty
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_WRITE_TOKEN=
