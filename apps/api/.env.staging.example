# Inject these into Railway (staging environment). Never commit real secrets.
# First smoke / tech talk: use console OTP + empty MPESA_* (simulate-complete).
# Client QA: switch SMS/email to sandbox providers below.

NODE_ENV=staging
PORT=4000

# After Railway + Vercel generate public URLs, paste them here (or custom domains).
# Example defaults before DNS:
#   APP_URL=https://greenkey-xxx.vercel.app
#   API_URL=https://greenkey-api-staging.up.railway.app
#   CORS_ORIGINS=https://greenkey-xxx.vercel.app
APP_URL=https://staging.yourdomain.com
API_URL=https://api-staging.yourdomain.com
CORS_ORIGINS=https://staging.yourdomain.com

DATABASE_URL=
# Upstash greenkey-staging — must be rediss://…
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Talk / first deploy: codes appear in Railway logs. Switch to AT/Mailtrap for client QA.
SMS_PROVIDER=console
WHATSAPP_ENABLED=false
EMAIL_PROVIDER=console
# --- Client QA providers (uncomment / fill when ready) ---
# SMS_PROVIDER=africastalking
# WHATSAPP_ENABLED=true
# WHATSAPP_PROVIDER=infobip
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SMS_FROM=
# AT_SANDBOX=true
# AT_WHATSAPP_NUMBER=
# INFOBIP_BASE_URL=https://YOUR_SUBDOMAIN.api.infobip.com
# INFOBIP_API_KEY=
# INFOBIP_WHATSAPP_FROM=447860099299
# EMAIL_PROVIDER=mailtrap
MAIL_FROM_NAME=GreenKey Realty
MAIL_FROM_EMAIL=noreply@greenkey.test
# MAILTRAP_USER=
# MAILTRAP_PASS=
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525

AGENT_PLAN_AMOUNT_KES=2500
AGENT_PLAN_DAYS=30

# Leave MPESA_* empty on staging to use simulate-complete (talk-safe).
ALLOW_PAYMENT_SIMULATE=true
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api-staging.yourdomain.com/v1/billing/mpesa/callback
MPESA_ACCOUNT_REFERENCE=GreenKeyAgent

BANK_NAME=Equity Bank
BANK_ACCOUNT_NAME=GreenKey Realty
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

SANITY_PROJECT_ID=
SANITY_DATASET=staging
SANITY_API_VERSION=2024-01-01
SANITY_WRITE_TOKEN=
