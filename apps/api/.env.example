# GreenKey API — copy to apps/api/.env

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://greenkey:greenkey@localhost:5433/greenkey?schema=public
REDIS_URL=redis://localhost:6379

# Host Postgres uses 5433 (Docker) because local PostgreSQL often occupies 5432.

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# =============================================================================
# SMS + WhatsApp — full guide: apps/api/docs/MESSAGING.md
# Phone OTP is always sent on BOTH SMS and WhatsApp (unless WHATSAPP_ENABLED=false).
# SMS: console | africastalking | twilio
# WhatsApp: auto | console | off | africastalking | twilio | meta | infobip
#   auto = Infobip if INFOBIP_API_KEY set, else mirror SMS, else console
# =============================================================================
SMS_PROVIDER=console
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=auto

# --- Africa's Talking (Kenya SMS + WhatsApp) ---
AT_USERNAME=
AT_API_KEY=
AT_SMS_FROM=
AT_SANDBOX=true
AT_WHATSAPP_NUMBER=
# AT_WHATSAPP_OTP_TEMPLATE_ID=
# AT_WHATSAPP_WELCOME_TEMPLATE_ID=

# --- Twilio (SMS + WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_OTP_CONTENT_SID=
# TWILIO_WHATSAPP_WELCOME_CONTENT_SID=

# --- Meta Cloud API (WhatsApp only) ---
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_OTP_TEMPLATE=otp_verify
# META_WHATSAPP_WELCOME_TEMPLATE=welcome
# META_WHATSAPP_TEMPLATE_LANG=en

# --- Infobip WhatsApp (recommended for WhatsApp OTP alongside AT SMS) ---
# Onboarding: https://portal.infobip.com/onboarding-guide
INFOBIP_BASE_URL=https://YOUR_SUBDOMAIN.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_FROM=447860099299
# INFOBIP_WHATSAPP_OTP_TEMPLATE=
# INFOBIP_WHATSAPP_WELCOME_TEMPLATE=
# INFOBIP_WHATSAPP_TEMPLATE_LANG=en
# INFOBIP_WHATSAPP_OTP_AUTH_BUTTON=false

# =============================================================================
# Email — full guide: apps/api/docs/EMAIL.md
# Providers: console | mailtrap | mailtrap-send | resend | sendgrid | smtp
#
# Local:      console
# QA/staging: mailtrap        (+ MAILTRAP_USER / MAILTRAP_PASS from Email Testing)
# Production: mailtrap-send | resend | sendgrid | smtp  (+ verified domain)
# =============================================================================
EMAIL_PROVIDER=console
MAIL_FROM_NAME=GreenKey Realty
MAIL_FROM_EMAIL=noreply@greenkey.test

# --- Mailtrap ---
# QA: Email Testing → inbox → SMTP Settings → Nodemailer → copy user/pass
#     EMAIL_PROVIDER=mailtrap  (defaults: sandbox.smtp.mailtrap.io:2525)
# Prod: Email Sending stream + verified domain
#     EMAIL_PROVIDER=mailtrap-send  (defaults: live.smtp.mailtrap.io:587)
MAILTRAP_USER=
MAILTRAP_PASS=
# MAILTRAP_HOST=
# MAILTRAP_PORT=

# --- Generic SMTP (SES, Postmark, custom relay) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set to false if local antivirus SSL scan causes "self-signed certificate in certificate chain"
# (defaults to false outside production; Mailtrap Testing always allows insecure TLS)
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- Resend (production) ---
RESEND_API_KEY=

# --- SendGrid (production) ---
SENDGRID_API_KEY=

# Agent plan (KES)
AGENT_PLAN_AMOUNT_KES=2500
AGENT_PLAN_DAYS=30

# M-Pesa Daraja (sandbox)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:4000/v1/billing/mpesa/callback
MPESA_ACCOUNT_REFERENCE=GreenKeyAgent

# Bank transfer instructions shown to users
BANK_NAME=Equity Bank
BANK_ACCOUNT_NAME=GreenKey Realty
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

# Sanity (write token for Nest; read can stay on Next)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
# Write token — required for listing/agent/lead mutations from the BFF
SANITY_WRITE_TOKEN=
