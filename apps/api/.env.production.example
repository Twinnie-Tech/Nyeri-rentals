# Copy secrets into your production host (never commit real values).
# Pick ONE email provider: mailtrap-send | resend | sendgrid | smtp

NODE_ENV=production
PORT=4000
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com
# Never enable on production
ALLOW_PAYMENT_SIMULATE=false

DATABASE_URL=
# Upstash (recommended) or Railway Redis — rediss://…
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

# --- SMS + WhatsApp (production) — OTP goes to SMS AND WhatsApp ---
SMS_PROVIDER=africastalking
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=auto
AT_USERNAME=
AT_API_KEY=
AT_SMS_FROM=GREENKEY
AT_SANDBOX=false
AT_WHATSAPP_NUMBER=
# AT_WHATSAPP_OTP_TEMPLATE_ID=
# AT_WHATSAPP_WELCOME_TEMPLATE_ID=
# Or Twilio / Meta — see docs/MESSAGING.md

# --- Email (production) — domain must be verified; SPF/DKIM/DMARC required ---
EMAIL_PROVIDER=mailtrap-send
MAIL_FROM_NAME=GreenKey Realty
MAIL_FROM_EMAIL=noreply@yourdomain.com

# Option A — Mailtrap Email Sending
MAILTRAP_USER=api
MAILTRAP_PASS=
# MAILTRAP_HOST=live.smtp.mailtrap.io
# MAILTRAP_PORT=587

# Option B — Resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# Option C — SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=

# Option D — Generic SMTP (SES, Postmark, …)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

AGENT_PLAN_AMOUNT_KES=2500
AGENT_PLAN_DAYS=30

MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.yourdomain.com/v1/billing/mpesa/callback
MPESA_ACCOUNT_REFERENCE=GreenKeyAgent

BANK_NAME=Equity Bank
BANK_ACCOUNT_NAME=GreenKey Realty
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_WRITE_TOKEN=
