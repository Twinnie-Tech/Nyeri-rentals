# Next.js — copy to `.env.local` (dev) or set in Vercel (staging / production).
# Never put SANITY_WRITE_TOKEN or JWT secrets here — Nest owns writes & auth.

# ========== DEVELOPMENT ==========
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# ========== STAGING (Vercel Preview / local Next → Render API) ==========
# See docs/WIRE_FRONTEND_TO_RENDER.md
# NEXT_PUBLIC_API_URL=https://greenkey-api-staging.onrender.com/v1
# API_URL=https://greenkey-api-staging.onrender.com/v1
# NEXT_PUBLIC_SANITY_PROJECT_ID=1nfit4k5
# NEXT_PUBLIC_SANITY_DATASET=staging
# NEXT_PUBLIC_MAPBOX_TOKEN=
# On Render: APP_URL + CORS_ORIGINS = your Vercel URL (and/or http://localhost:3000)

# ========== PRODUCTION (Vercel Production / main) ==========
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/v1
# API_URL=https://api.yourdomain.com/v1
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_MAPBOX_TOKEN=
